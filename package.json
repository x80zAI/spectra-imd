{
  "name": "spectra-imd",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 5191",
    "preview": "vite preview --host 127.0.0.1 --port 5191",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "contracts:compile": "node scripts/compile-contracts.mjs",
    "contracts:test": "node scripts/test-contracts.mjs",
    "build": "npm run contracts:compile && tsc --noEmit && vite build"
  },
  "dependencies": {
    "@fontsource-variable/manrope": "5.2.8",
    "@fontsource/space-mono": "5.3.0",
    "@openzeppelin/contracts": "5.6.1",
    "@phosphor-icons/react": "2.1.10",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "viem": "2.57.2"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "24.0.0",
    "@types/react": "19.0.0",
    "@types/react-dom": "19.0.0",
    "@vitejs/plugin-react": "6.1.1",
    "eslint": "10.12.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "ganache": "7.9.2",
    "globals": "16.0.0",
    "solc": "0.8.30",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.0",
    "vite": "8.3.2",
    "vitest": "5.0.3"
  }
}
